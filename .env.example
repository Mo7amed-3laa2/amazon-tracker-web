# Where the SQLite file lives. Defaults to ./tracker.db next to database.py.
DB_PATH=./tracker.db

# Minutes between price scans. The bot stored this in the settings table so it
# could be changed at runtime; get_check_interval() reads that and falls back
# to this value.
CHECK_INTERVAL_MINUTES=60

# Signing key for session cookies. Leave it unset and the app generates one on
# first start and keeps it in the settings table, so logins survive a restart
# either way. Set it explicitly to invalidate every existing session.
SESSION_SECRET=

# Where the Vite dev server runs, allowed through CORS with credentials so the
# session cookie works during development. Unused once web/dist is built and
# served by FastAPI from the same origin.
DEV_ORIGIN=http://localhost:5173
